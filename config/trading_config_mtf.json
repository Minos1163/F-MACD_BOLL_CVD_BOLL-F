{
  "mtf_system_v2": {
    "version": "2.0",
    "name": "Five_Layer_Resonance_System",
    "description": "五层共振交易系统 - 4H宏观定调 → 1H趋势确认 → 15m回调买点 → 5m启动确认 → 1m精准入场",
    
    "five_layers": {
      "layer_1_4h": {
        "name": "宏观定调层",
        "period": "4h",
        "weight": 20,
        "conditions": {
          "long": [
            "价格 > EMA200 (市场长期偏多)",
            "MACD柱 > 0 (动能向上)"
          ],
          "short": [
            "价格 < EMA200 (市场长期偏空)",
            "MACD柱 < 0 (动能向下)"
          ]
        },
        "role": "一票否决制，定调大方向"
      },
      "layer_2_1h": {
        "name": "趋势确认层",
        "period": "1h",
        "weight": 25,
        "conditions": {
          "long": [
            "价格 > EMA55 (趋势稳定)",
            "MACD向上 (动能向上)",
            "价格 > VWAP (多头控制)"
          ],
          "short": [
            "价格 < EMA55 (趋势稳定)",
            "MACD向下 (动能向下)",
            "价格 < VWAP (空头控制)"
          ]
        },
        "role": "信号生成核心，市场状态识别"
      },
      "layer_3_15m": {
        "name": "回调买点层",
        "period": "15m",
        "weight": 20,
        "conditions": {
          "long": [
            "MACD金叉 (动能转强)",
            "价格回踩EMA21 (趋势中的回调买点)"
          ],
          "short": [
            "MACD死叉 (动能转弱)",
            "价格反弹至EMA21 (趋势中的反弹卖点)"
          ]
        },
        "role": "寻找趋势中的回调买点"
      },
      "layer_4_5m": {
        "name": "启动确认层",
        "period": "5m",
        "weight": 20,
        "conditions": {
          "long": [
            "MACD金叉 (动能启动)",
            "价格突破VWAP (资金开始推动行情)"
          ],
          "short": [
            "MACD死叉 (动能启动)",
            "价格跌破VWAP (资金开始推动下跌)"
          ]
        },
        "role": "资金推动确认"
      },
      "layer_5_1m": {
        "name": "精准入场层",
        "period": "1m",
        "weight": 15,
        "conditions": {
          "long": [
            "MACD金叉 (启动信号)",
            "价格站上VWAP (确认启动)"
          ],
          "short": [
            "MACD死叉 (启动信号)",
            "价格跌破VWAP (确认启动)"
          ]
        },
        "role": "捕捉启动瞬间"
      }
    },
    
    "vwap_config": {
      "description": "VWAP机构成本线 - 贯穿全流程",
      "formula": "VWAP = Σ(Price × Volume) / ΣVolume",
      "meaning": {
        "price_above_vwap": "多头控制",
        "price_below_vwap": "空头控制"
      },
      "usage": {
        "1h": "确认趋势方向，价格必须在VWAP正确一侧",
        "5m": "确认资金推动，价格突破VWAP代表资金入场",
        "1m": "精准入场确认，价格站上VWAP代表启动瞬间"
      },
      "anchor": "session"
    },
    
    "indicators": {
      "ema": {
        "fast_period": 21,
        "medium_period": 55,
        "slow_period": 200,
        "usage": {
          "ema21": "15m/5m回踩参考",
          "ema55": "1H趋势确认",
          "ema200": "4H宏观趋势"
        }
      },
      "macd_4h": {
        "fast_period": 12,
        "slow_period": 26,
        "signal_period": 9,
        "purpose": "宏观方向定调"
      },
      "macd_1h": {
        "fast_period": 12,
        "slow_period": 26,
        "signal_period": 9,
        "purpose": "趋势动能确认"
      },
      "macd_15m": {
        "fast_period": 8,
        "slow_period": 21,
        "signal_period": 5,
        "purpose": "回调买点识别"
      },
      "macd_5m": {
        "fast_period": 8,
        "slow_period": 21,
        "signal_period": 5,
        "purpose": "启动动能确认"
      },
      "macd_1m": {
        "fast_period": 8,
        "slow_period": 21,
        "signal_period": 5,
        "purpose": "精准入场信号"
      }
    },
    
    "scoring": {
      "total_max_score": 100,
      "pass_threshold": 70,
      "s_grade": {
        "description": "五层全共振 - 全仓",
        "min_layers": 5,
        "min_score": 90,
        "position_multiplier": 1.0
      },
      "a_grade": {
        "description": "四层共振 - 半仓",
        "min_layers": 4,
        "min_score": 70,
        "position_multiplier": 0.5
      },
      "b_grade": {
        "description": "三层及以下 - 忽略",
        "min_layers": 3,
        "min_score": 0,
        "position_multiplier": 0.0
      }
    },
    
    "resonance_flow": {
      "description": "做多共振系统流程",
      "steps": [
        {
          "step": 1,
          "layer": "4H",
          "check": "价格 > EMA200 且 MACD柱 > 0",
          "meaning": "市场长期偏多",
          "required": true
        },
        {
          "step": 2,
          "layer": "1H",
          "check": "价格 > EMA55 且 MACD向上 且 价格 > VWAP",
          "meaning": "趋势稳定，多头控制",
          "required": true
        },
        {
          "step": 3,
          "layer": "15m",
          "check": "MACD金叉 且 价格回踩EMA21",
          "meaning": "趋势中的回调买点",
          "required": false
        },
        {
          "step": 4,
          "layer": "5m",
          "check": "MACD金叉 且 价格突破VWAP",
          "meaning": "资金开始推动行情",
          "required": false
        },
        {
          "step": 5,
          "layer": "1m",
          "check": "MACD金叉 且 价格站上VWAP",
          "meaning": "启动瞬间",
          "required": false
        }
      ]
    },
    
    "risk_management": {
      "position_sizing": {
        "method": "ATR或结构距离动态计算",
        "max_risk_per_trade": 0.015,
        "max_position_size_pct": 0.6
      },
      "risk_reward": {
        "minimum": 2.0,
        "target_range": [2.5, 4.0]
      },
      "portfolio": {
        "max_active_symbols": 3,
        "max_daily_trades": 5,
        "max_concurrent_positions": 2
      }
    },
    
    "exit_logic": {
      "stop_loss": {
        "methods": [
          "结构止损：1H K线实体收盘在EMA55之下",
          "VWAP止损：价格跌破VWAP且MACD死叉",
          "风控止损：单笔最大亏损1.5%"
        ]
      },
      "take_profit": {
        "method": "分批平仓",
        "targets": [
          {"trigger": "风险回报比2:1", "action": "平仓30%"},
          {"trigger": "风险回报比3:1", "action": "平仓40%"},
          {"trigger": "1H MACD背离或死叉", "action": "平仓剩余"}
        ]
      }
    },
    
    "reentry_suppression": {
      "max_stop_losses_per_day": 2,
      "freeze_duration_hours": 24,
      "scope": "单一标的"
    }
  }
}
